<Window x:Class="Pegline.App.Views.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pegline"
        Width="800"
        Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        SizeChanged="OnSizeChanged">
  <Grid IsHitTestVisible="True">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" Y="-210" />
    </Grid.RenderTransform>

    <Canvas Height="48" VerticalAlignment="Top" IsHitTestVisible="False">
      <Canvas.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00000000" Offset="0" />
          <GradientStop Color="#FF000000" Offset="0.06" />
          <GradientStop Color="#FF000000" Offset="0.94" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Canvas.OpacityMask>
      <Path x:Name="RopeShadow" Stroke="#38000000" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Path.RenderTransform>
          <TranslateTransform Y="1.4" />
        </Path.RenderTransform>
      </Path>
      <Path x:Name="RopeCore" Stroke="#FF8A8175" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <Path x:Name="RopeHighlight" Stroke="#66FFFFFF" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Path.RenderTransform>
          <TranslateTransform Y="-0.7" />
        </Path.RenderTransform>
      </Path>
    </Canvas>

    <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="Card" Width="{Binding ChromeWidth}" Background="Transparent"
                  RenderTransformOrigin="0.5,0" Opacity="{Binding Opacity}"
                  MouseLeftButtonUp="CardClicked" Cursor="Hand">
            <Border.RenderTransform>
              <RotateTransform Angle="{Binding Tilt}" />
            </Border.RenderTransform>
            <Grid>
              <Border Width="9" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-8,0,0" CornerRadius="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF9AA3AD" Offset="0" />
                    <GradientStop Color="#FFF4F7FA" Offset="0.45" />
                    <GradientStop Color="#FF6E7782" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Border Width="3" Height="7" Background="#FF3A4148" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Border Margin="0,6,0,0" Padding="4" CornerRadius="12" Background="#F7FBFCFF" BorderBrush="#FFFFFFFF" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="90" Opacity="0.28" Color="#FF000000" />
                </Border.Effect>
                <Grid>
                  <Image Source="{Binding Image}" Width="{Binding PhotoWidth}" Height="{Binding PhotoHeight}" Stretch="Uniform" />
                  <Border Background="#CC1F6B3A" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Padding="8,3" Visibility="{Binding Copied, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
                    <TextBlock Text="Copied  已复制" Foreground="White" FontSize="12" />
                  </Border>
                  <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                          Width="18" Height="18" Click="RemoveClicked" Focusable="False" Cursor="Hand">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Foreground" Value="#FF3C3C3C" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border Background="#F2FFFFFF" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <TextBlock Text="&#x2715;" />
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,36,24,0"
               TextAlignment="Center" Foreground="#FF4A453C" FontSize="13"
               IsHitTestVisible="False"
               Visibility="{Binding ShowHint, Converter={StaticResource BoolVis}}">
      <Run Text="Rest the pointer on the top edge, or press " />
      <Run Text="{Binding CaptureShortcut, Mode=OneWay}" />
      <Run Text=" to take a shot." />
      <LineBreak />
      <Run Text="指针停在屏幕上沿，或按快捷键截图。" />
    </TextBlock>
  </Grid>
</Window>
