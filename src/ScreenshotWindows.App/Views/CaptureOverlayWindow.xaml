<Window x:Class="ScreenshotWindows.App.Views.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="screenshot-windows"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross"
        Focusable="True"
        PreviewMouseLeftButtonDown="OnMouseLeftButtonDown"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseLeftButtonUp="OnMouseLeftButtonUp"
        PreviewMouseRightButtonDown="OnMouseRightButtonDown"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid>
    <Image x:Name="Shot" Stretch="Fill" />
    <Canvas x:Name="Shade" IsHitTestVisible="False">
      <Rectangle x:Name="DimTop" Fill="#88000000" />
      <Rectangle x:Name="DimLeft" Fill="#88000000" />
      <Rectangle x:Name="DimRight" Fill="#88000000" />
      <Rectangle x:Name="DimBottom" Fill="#88000000" />
      <Rectangle x:Name="Stroke" Stroke="#FF3D8BFF" StrokeThickness="2" Fill="Transparent" Visibility="Collapsed" />
      <Border x:Name="Badge" Background="#CC1C1C1C" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
        <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
      </Border>
    </Canvas>
    <Border x:Name="Hint" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,48"
            Background="#AA1C1C1C" CornerRadius="8" Padding="14,8" IsHitTestVisible="False">
      <StackPanel>
        <TextBlock Foreground="White" FontSize="14" TextAlignment="Center"
                   Text="Drag to select    Enter or double-click for this screen    Esc or right-click to cancel" />
        <TextBlock Foreground="#FFE4E4E4" FontSize="13" TextAlignment="Center" Margin="0,4,0,0"
                   Text="拖拽选择区域    回车或双击截取当前屏幕    Esc 或右键取消" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
