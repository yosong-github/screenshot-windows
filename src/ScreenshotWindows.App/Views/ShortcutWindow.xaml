<Window x:Class="ScreenshotWindows.App.Views.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="screenshot-windows"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FFF7F4EF"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">
  <StackPanel Margin="22">
    <TextBlock FontSize="18" Foreground="#FF2C2924" Text="Shortcuts  快捷键" />
    <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Foreground="#FF5C564C"
               Text="Ctrl+Alt+S takes a shot. Ctrl+Alt+A is left free for QQ and WeChat. Backspace clears the line shortcut only.&#x0a;Ctrl+Alt+S 截图。Ctrl+Alt+A 留给 QQ / 微信。只有绳子快捷键可以用退格键清除。" />

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Foreground="#FF2C2924" Text="Take a screenshot  截图" />
        <TextBlock x:Name="CaptureLabel" Margin="0,2,0,0" Foreground="#FF3D6B8B" />
      </StackPanel>
      <Button Grid.Column="1" MinWidth="88" Padding="10,4" VerticalAlignment="Center" Click="BeginCapture"
              Content="Change  更改" />
    </Grid>

    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Foreground="#FF2C2924" Text="Show or hide the line  显示或隐藏绳子" />
        <TextBlock x:Name="LineLabel" Margin="0,2,0,0" Foreground="#FF3D6B8B" />
      </StackPanel>
      <Button Grid.Column="1" MinWidth="88" Padding="10,4" VerticalAlignment="Center" Click="BeginLine"
              Content="Change  更改" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button MinWidth="88" Margin="0,0,8,0" Padding="10,4" IsCancel="True" Content="Cancel  取消" />
      <Button MinWidth="88" Padding="10,4" IsDefault="True" Click="Accept" Content="OK  确定" />
    </StackPanel>
  </StackPanel>
</Window>
