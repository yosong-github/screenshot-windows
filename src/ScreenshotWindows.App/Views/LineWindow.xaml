<Window x:Class="ScreenshotWindows.App.Views.LineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:ScreenshotWindows.Core.Domain;assembly=ScreenshotWindows.Core"
        xmlns:views="clr-namespace:ScreenshotWindows.App.Views"
        Title="screenshot-windows"
        Width="800"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        SizeChanged="OnSizeChanged">
  <Grid>
    <Grid x:Name="LineRoot" IsHitTestVisible="True">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" Y="-280" />
    </Grid.RenderTransform>

    <Canvas x:Name="RopeHost" Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
      <Canvas.OpacityMask>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00000000" Offset="0" />
          <GradientStop Color="#FF000000" Offset="0.06" />
          <GradientStop Color="#FF000000" Offset="0.94" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Canvas.OpacityMask>
      <Path x:Name="RopeShadow" Stroke="#66000000" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Path.RenderTransform>
          <TranslateTransform Y="1.6" />
        </Path.RenderTransform>
      </Path>
      <Path x:Name="RopeCore" Stroke="#FF8A8175" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <Path x:Name="RopeHighlight" Stroke="#CCFFFFFF" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Path.RenderTransform>
          <TranslateTransform Y="-0.8" />
        </Path.RenderTransform>
      </Path>
    </Canvas>

    <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Canvas />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="ContentPresenter">
          <Setter Property="Canvas.Left" Value="{Binding Left}" />
          <Setter Property="Canvas.Top" Value="{Binding Top}" />
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="Transparent" Opacity="{Binding Opacity}"
                  MouseEnter="CardHover" MouseLeave="CardHover"
                  MouseLeftButtonUp="CardClicked" Cursor="Hand">
            <Border.RenderTransform>
              <TranslateTransform X="{Binding ShiftX}" Y="{Binding ShiftY}" />
            </Border.RenderTransform>
            <Canvas Width="{Binding ChromeWidth}" Height="{Binding ChromeHeight}">
              <Canvas.RenderTransform>
                <RotateTransform Angle="{Binding VisualAngle}"
                                 CenterX="{Binding PivotX}"
                                 CenterY="{Binding PivotY}" />
              </Canvas.RenderTransform>
              <Border Canvas.Top="{Binding FrameTop}"
                      Width="{Binding ChromeWidth}"
                      Height="{Binding FrameHeight}"
                      Padding="{Binding FramePadding}"
                      CornerRadius="{Binding FrameCorner}"
                      BorderThickness="1"
                      Background="#F4FFFFFF" BorderBrush="#E6FFFFFF"
                      RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                  <ScaleTransform ScaleX="{Binding HoverScale}" ScaleY="{Binding HoverScale}" />
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="{Binding ShadowBlur}" ShadowDepth="{Binding ShadowDepth}"
                                    Opacity="{Binding ShadowOpacity}" Direction="90" Color="#FF000000" />
                </Border.Effect>
                <Grid>
                  <Border CornerRadius="{Binding PhotoCorner}" Background="{Binding PhotoBrush}" />
                  <Border Background="#CC1F6B3A" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Padding="8,3" Visibility="{Binding Copied, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
                    <TextBlock Text="Copied  已复制" Foreground="White" FontSize="12" />
                  </Border>
                  <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                          Width="18" Height="18" Opacity="{Binding CloseOpacity}"
                          Click="RemoveClicked" Focusable="False" Cursor="Hand">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="#F2FFFFFF" CornerRadius="9">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#x2715;" Foreground="#FF3C3C3C" FontSize="11" />
                  </Button>
                </Grid>
              </Border>
              <views:PegView Width="{x:Static domain:LineLayout.ClipWidth}"
                             Height="{x:Static domain:LineLayout.ClipHeight}"
                             Canvas.Left="{Binding ClipLeft}" Canvas.Top="0"
                             Body="{Binding ClipBody}" Edge="{Binding ClipEdge}" Shine="{Binding ClipShine}" />
            </Canvas>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,64,24,0"
               TextAlignment="Center" Foreground="#FF4A453C" FontSize="13"
               IsHitTestVisible="False"
               Visibility="{Binding ShowHint, Converter={StaticResource BoolVis}}">
      <Run Text="Press " />
      <Run Text="{Binding CaptureShortcut, Mode=OneWay}" />
      <Run Text=" to take a shot." />
      <LineBreak />
      <Run Text="按快捷键截图。" />
    </TextBlock>
    </Grid>
    <Border x:Name="HandleHost"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#F8FFFFFF"
            Visibility="Collapsed"
            IsHitTestVisible="False">
      <Border.RenderTransform>
        <TranslateTransform x:Name="HandleSlide" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="6" ShadowDepth="1.2" Direction="90" Opacity="0.32" Color="#FF000000" />
      </Border.Effect>
      <Border Width="16" Height="2" CornerRadius="1" Background="#4D3C3C3C"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
