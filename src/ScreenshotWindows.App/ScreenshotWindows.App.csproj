<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ScreenshotWindows.App</RootNamespace>
    <AssemblyName>screenshot-windows</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The manifest also declares PerMonitorV2. WFAC010 wants WinForms apps to use only the API. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\screenshot-windows.ico</ApplicationIcon>
    <Description>Screenshots hang from a line along the top of the screen.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScreenshotWindows.Platform\ScreenshotWindows.Platform.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\screenshot-windows.ico" Link="Assets\screenshot-windows.ico" />
  </ItemGroup>
</Project>
